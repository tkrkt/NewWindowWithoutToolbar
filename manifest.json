{
  "name": "__MSG_appName__",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "commands": {
    "open-new-window": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "__MSG_openNewWindowCommand__"
    }
  }
}
